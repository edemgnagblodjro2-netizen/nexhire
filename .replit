modules = ["nodejs-24", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3000

[[ports]]
localPort = 8083
externalPort = 5000

[[ports]]
localPort = 8084
externalPort = 6000

[[ports]]
localPort = 8085
externalPort = 8000

[[ports]]
localPort = 8086
externalPort = 8099

[[ports]]
localPort = 22729
externalPort = 80

[[ports]]
localPort = 22730
externalPort = 3001

[[ports]]
localPort = 23744
externalPort = 3002

[[ports]]
localPort = 23745
externalPort = 3003

[[ports]]
localPort = 23746
externalPort = 4200

[[ports]]
localPort = 23747
externalPort = 5173

[[ports]]
localPort = 23748
externalPort = 8008

[[ports]]
localPort = 23749
externalPort = 6800

[[ports]]
localPort = 23750
externalPort = 9000

[nix]
channel = "stable-25_05"
packages = ["zip"]

[userenv]

[userenv.shared]
EXPO_PUBLIC_API_URL = "https://quebec-aid-finder.replit.app"
ADMIN_API_KEY = "attentezero-admin-2026"
NOTIFY_FROM_EMAIL = "AttenteZéro <notify@attentezero.ca>"
NOTIFY_EMAIL = "admin@attentezero.ca"
