{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource — pointer vers /metrics de l'app AgentHub",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "row", "name": "Row", "version": "" }
  ],
  "uid": "agenthub-rc1-readiness",
  "title": "AgentHub RC1 – Production Readiness",
  "description": "Trafic · Performance SQL/HTTP · Fiabilité · Cache (Sprint 3D)",
  "tags": ["agenthub", "rc1", "production"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "schemaVersion": 38,
  "version": 1,
  "panels": [

    { "type": "row", "id": 1, "title": "🚦 Trafic", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 2, "title": "HTTP req / min",
      "type": "stat", "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum(rate(http_requests_total[5m])) * 60",
        "legendFormat": "req/min"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "orientation": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 60 }, { "color": "red", "value": 300 }] }, "unit": "reqpm" } }
    },

    {
      "id": 3, "title": "SQL blocs / min",
      "type": "stat", "gridPos": { "x": 6, "y": 1, "w": 6, "h": 4 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum(rate(sql_query_total[5m])) * 60",
        "legendFormat": "SQL/min"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 120 }, { "color": "red", "value": 600 }] }, "unit": "reqpm" } }
    },

    {
      "id": 4, "title": "HTTP actives (jauge)",
      "type": "stat", "gridPos": { "x": 12, "y": 1, "w": 6, "h": 4 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "http_active_requests",
        "legendFormat": "actives"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 30 }] } } }
    },

    {
      "id": 5, "title": "SQL actives (jauge)",
      "type": "stat", "gridPos": { "x": 18, "y": 1, "w": 6, "h": 4 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sql_active_queries",
        "legendFormat": "actives"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 15 }] } } }
    },

    { "type": "row", "id": 10, "title": "⚡ Performance HTTP", "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 11, "title": "HTTP Latence — p50 / p95 / p99",
      "type": "timeseries", "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "palette-classic" } } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },

    {
      "id": 12, "title": "Top 10 endpoints HTTP les plus lents (p95)",
      "type": "table", "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "topk(10, histogram_quantile(0.95, sum(rate(http_request_duration_ms_bucket[5m])) by (le, endpoint)))",
        "legendFormat": "{{endpoint}}",
        "instant": true,
        "format": "table"
      }],
      "fieldConfig": {
        "defaults": { "unit": "ms" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "endpoint" }, "properties": [{ "id": "custom.width", "value": 380 }] },
          { "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "displayName", "value": "p95 (ms)" }, { "id": "custom.displayMode", "value": "color-background" }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 200 }, { "color": "red", "value": 1000 }] } }] }
        ]
      },
      "options": { "sortBy": [{ "displayName": "p95 (ms)", "desc": true }] },
      "transformations": [{ "id": "filterFieldsByName", "options": { "include": { "names": ["endpoint", "Value"] } } }]
    },

    { "type": "row", "id": 20, "title": "🗄️ Performance SQL", "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 21, "title": "SQL Latence — p50 / p95 / p99",
      "type": "timeseries", "gridPos": { "x": 0, "y": 15, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.50, sum(rate(sql_query_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum(rate(sql_query_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.99, sum(rate(sql_query_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "palette-classic" } } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },

    {
      "id": 22, "title": "Top 10 endpoints SQL les plus lents (p95)",
      "type": "table", "gridPos": { "x": 12, "y": 15, "w": 12, "h": 8 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "topk(10, histogram_quantile(0.95, sum(rate(sql_query_duration_ms_bucket[5m])) by (le, endpoint)))",
        "legendFormat": "{{endpoint}}",
        "instant": true,
        "format": "table"
      }],
      "fieldConfig": {
        "defaults": { "unit": "ms" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "endpoint" }, "properties": [{ "id": "custom.width", "value": 380 }] },
          { "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "displayName", "value": "p95 SQL (ms)" }, { "id": "custom.displayMode", "value": "color-background" }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 200 }] } }] }
        ]
      },
      "options": { "sortBy": [{ "displayName": "p95 SQL (ms)", "desc": true }] },
      "transformations": [{ "id": "filterFieldsByName", "options": { "include": { "names": ["endpoint", "Value"] } } }]
    },

    {
      "id": 23, "title": "SQL req/min par endpoint (volume)",
      "type": "timeseries", "gridPos": { "x": 0, "y": 23, "w": 24, "h": 7 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "topk(10, sum(rate(sql_query_total[5m])) by (endpoint)) * 60",
        "legendFormat": "{{endpoint}}"
      }],
      "fieldConfig": { "defaults": { "unit": "reqpm", "color": { "mode": "palette-classic" } } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } }
    },

    { "type": "row", "id": 30, "title": "🔴 Fiabilité", "gridPos": { "x": 0, "y": 30, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 31, "title": "HTTP 5xx / min",
      "type": "timeseries", "gridPos": { "x": 0, "y": 31, "w": 8, "h": 6 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[5m])) * 60",
        "legendFormat": "5xx/min"
      }],
      "fieldConfig": { "defaults": { "unit": "reqpm", "color": { "fixedColor": "red", "mode": "fixed" } } },
      "options": { "tooltip": { "mode": "single" } }
    },

    {
      "id": 32, "title": "SQL erreurs / min",
      "type": "timeseries", "gridPos": { "x": 8, "y": 31, "w": 8, "h": 6 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum(rate(sql_query_errors_total[5m])) * 60",
        "legendFormat": "erreurs SQL/min"
      }],
      "fieldConfig": { "defaults": { "unit": "reqpm", "color": { "fixedColor": "orange", "mode": "fixed" } } },
      "options": { "tooltip": { "mode": "single" } }
    },

    {
      "id": 33, "title": "Taux d'erreur HTTP (%)",
      "type": "stat", "gridPos": { "x": 16, "y": 31, "w": 4, "h": 6 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "100 * sum(rate(http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(http_requests_total[5m]))",
        "legendFormat": "5xx %"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "orientation": "auto" },
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } } }
    },

    {
      "id": 34, "title": "Taux d'erreur SQL (%)",
      "type": "stat", "gridPos": { "x": 20, "y": 31, "w": 4, "h": 6 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "100 * sum(rate(sql_query_errors_total[5m])) / sum(rate(sql_query_total[5m]))",
        "legendFormat": "SQL erreur %"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 2 }] } } }
    },

    {
      "id": 35, "title": "Distribution codes HTTP",
      "type": "timeseries", "gridPos": { "x": 0, "y": 37, "w": 24, "h": 6 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(http_requests_total{status_code=~\"2..\"}[5m])) * 60",
          "legendFormat": "2xx"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(http_requests_total{status_code=~\"4..\"}[5m])) * 60",
          "legendFormat": "4xx"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[5m])) * 60",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqpm", "color": { "mode": "palette-classic" } } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },

    { "type": "row", "id": 40, "title": "⚡ Cache Redis (Sprint 3D — données dès le branchement)", "gridPos": { "x": 0, "y": 43, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 41, "title": "Cache Hit Ratio global",
      "type": "gauge", "gridPos": { "x": 0, "y": 44, "w": 6, "h": 6 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum(rate(cache_hits_total[5m])) / (sum(rate(cache_hits_total[5m])) + sum(rate(cache_misses_total[5m])))",
        "legendFormat": "hit ratio"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "minVizWidth": 75, "minVizHeight": 75, "showThresholdLabels": false, "showThresholdMarkers": true },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "green", "value": 0.8 }] } } }
    },

    {
      "id": 42, "title": "Cache Hits vs Misses / min",
      "type": "timeseries", "gridPos": { "x": 6, "y": 44, "w": 10, "h": 6 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(cache_hits_total[5m])) * 60",
          "legendFormat": "hits/min"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(cache_misses_total[5m])) * 60",
          "legendFormat": "misses/min"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqpm", "color": { "mode": "palette-classic" } } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },

    {
      "id": 43, "title": "Hit Ratio par endpoint",
      "type": "table", "gridPos": { "x": 16, "y": 44, "w": 8, "h": 6 },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum(rate(cache_hits_total[5m])) by (endpoint) / (sum(rate(cache_hits_total[5m])) by (endpoint) + sum(rate(cache_misses_total[5m])) by (endpoint))",
        "legendFormat": "{{endpoint}}",
        "instant": true,
        "format": "table"
      }],
      "fieldConfig": {
        "defaults": { "unit": "percentunit" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "endpoint" }, "properties": [{ "id": "custom.width", "value": 220 }] },
          { "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "displayName", "value": "Hit Ratio" }, { "id": "custom.displayMode", "value": "color-background" }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "green", "value": 0.8 }] } }] }
        ]
      },
      "options": { "sortBy": [{ "displayName": "Hit Ratio", "desc": false }] },
      "transformations": [{ "id": "filterFieldsByName", "options": { "include": { "names": ["endpoint", "Value"] } } }]
    }

  ]
}
