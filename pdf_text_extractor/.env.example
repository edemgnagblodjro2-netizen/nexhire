# Supabase — Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>

# Supabase — Project Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET=<jwt-secret>

# Fernet encryption key(s) — comma-separated for key rotation
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEYS=<fernet-key>

# ── LLM backend (ai_service.py) ──────────────────────────────────────────────
# LLM_PROVIDER=openai (default) | azure | openai_compatible

# Option A — OpenAI (default)
OPENAI_API_KEY=<openai-api-key>
OPENAI_MODEL=gpt-4o-mini          # optional, default: gpt-4o-mini

# Option B — Azure OpenAI (set LLM_PROVIDER=azure)
# AZURE_OPENAI_KEY=<azure-key>
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=<deployment-name>
# AZURE_OPENAI_API_VERSION=2024-02-15-preview  # optional

# Option C — OpenAI-compatible private model (set LLM_PROVIDER=openai_compatible)
# OPENAI_API_KEY=<key-or-placeholder>
# OPENAI_API_BASE=http://localhost:11434/v1    # e.g. Ollama
# OPENAI_MODEL=llama3

# ── Connecteurs OAuth ─────────────────────────────────────────────────────────

# Microsoft 365 — Azure App Registration (https://portal.azure.com)
M365_CLIENT_ID=<azure-app-client-id>
M365_CLIENT_SECRET=<azure-app-client-secret>
M365_REDIRECT_URI=https://<your-domain>/api/connectors/oauth/callback

# Salesforce — Connected App (Setup > App Manager > New Connected App)
SF_CLIENT_ID=<salesforce-consumer-key>
SF_CLIENT_SECRET=<salesforce-consumer-secret>
SF_REDIRECT_URI=https://<your-domain>/api/connectors/oauth/callback
# SF_INSTANCE_URL=https://login.salesforce.com  # or test.salesforce.com for sandbox

# ServiceNow — OAuth (sys_oauth_entity.do in your ServiceNow instance)
SNOW_CLIENT_ID=<servicenow-client-id>
SNOW_CLIENT_SECRET=<servicenow-client-secret>
SNOW_INSTANCE_URL=https://<instance>.service-now.com
SNOW_REDIRECT_URI=https://<your-domain>/api/connectors/oauth/callback

# Jira (Atlassian Cloud) — OAuth 2.0 (developer.atlassian.com)
JIRA_CLIENT_ID=<atlassian-client-id>
JIRA_CLIENT_SECRET=<atlassian-client-secret>
JIRA_REDIRECT_URI=https://<your-domain>/api/connectors/oauth/callback

# Zendesk — OAuth (Admin > Apps and Integrations > OAuth Clients)
ZENDESK_CLIENT_ID=<zendesk-client-id>
ZENDESK_CLIENT_SECRET=<zendesk-client-secret>
ZENDESK_SUBDOMAIN=<your-subdomain>   # ex: monentreprise
ZENDESK_REDIRECT_URI=https://<your-domain>/api/connectors/oauth/callback

# HubSpot — OAuth (Private App ou OAuth App dans developer.hubspot.com)
HUBSPOT_CLIENT_ID=<hubspot-client-id>
HUBSPOT_CLIENT_SECRET=<hubspot-client-secret>
HUBSPOT_REDIRECT_URI=https://<your-domain>/api/connectors/oauth/callback

# SAP — API key / Basic Auth (pas d'OAuth standard)
# À configurer via le formulaire dans l'interface Connecteurs

# Workday — API key / ISSG credentials
# À configurer via le formulaire dans l'interface Connecteurs

# Autotask — API key (Datto PSA)
# À configurer via le formulaire dans l'interface Connecteurs

# ── Stripe Billing ────────────────────────────────────────────────────────────
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...

# Dashboard → Developers → Webhooks → Add endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Dashboard → Products → NexHire Premium → Prices
STRIPE_PRICE_MONTHLY=price_...   # 99 $/mois
STRIPE_PRICE_ANNUAL=price_...    # 990 $/an

# URL publique de l'app (pour les redirects Stripe checkout)
APP_URL=https://nexhire.ca
