{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://quebec-aid-finder.replit.app",
        "EAS_NO_VCS": "1",
        "EXPO_ROUTER_APP_ROOT": "./app"
      },
      "prebuildCommand": "expo prebuild --no-install --platform android"
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "resourceClass": "m-medium",
        "autoIncrement": "buildNumber"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://quebec-aid-finder.replit.app",
        "EAS_NO_VCS": "1",
        "EXPO_ROUTER_APP_ROOT": "./app"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      },
      "ios": {
        "ascApiKeyPath": "./asc-api-key.p8",
        "ascApiKeyId": "T82TVVZ6A3",
        "ascApiKeyIssuerId": "a26b1f80-8f7a-400c-b8bf-16829f9c37d0",
        "appleTeamId": "2KS29FQVHX"
      }
    }
  }
}
